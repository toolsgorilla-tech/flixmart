# Supabase — from your project's Settings → API page.
# Get a project at https://supabase.com/dashboard

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never commit a real value.
# Used in app/admin/(protected)/users (inviting staff accounts via the
# Supabase Admin API) and by `npm run seed:catalog` (scripts/seed-catalog.ts,
# a one-time script that migrates the existing lib/data.ts product catalog
# into Supabase — see SETUP.md step 4). Media uploads use the regular
# authenticated client and rely on Storage RLS policies instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
